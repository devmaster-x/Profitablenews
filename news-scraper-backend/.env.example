# Copy to .env and adjust. Every variable is optional — defaults live in
# news_scraper/config.py. Names are case-insensitive (pydantic-settings).

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# --- Scheduler ---------------------------------------------------------
# Production / trading-system integration (see TRACK_C_UPGRADES.md):
# scrape every 5 minutes and start the scheduler with the server.
SCRAPE_INTERVAL_MINUTES=5
SCHEDULER_AUTOSTART=true
# Daily fallback schedule, used only when SCRAPE_INTERVAL_MINUTES=0.
DEFAULT_SCRAPING_TIME=00:00

# --- Scraping ----------------------------------------------------------
SCRAPING_TIMEOUT=30
MAX_ARTICLES_PER_SOURCE=50

# --- Backtesting -------------------------------------------------------
# CoinGecko free tier really allows ~10 calls/min; price_fetcher paces at 6s
# and backs off on 429 regardless of this legacy delay setting.
BACKTEST_ENABLED=true

# --- Alerts (SECRET — set the real webhook only in .env, never commit) --
SLACK_NOTIFICATION_WEBHOOK=

# --- CORS (frontend dev servers) ---------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
